[Unit]
Description=Qwen3.8-27B ROCmFPX llama-server
After=network-online.target

[Service]
Type=simple
User=oval
WorkingDirectory=/home/oval
# 设置ROCm相关环境变量（关键）
Environment=ROCBLAS_USE_HIPBLASLT=1
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1


# 你的完整启动命令
#ExecStart=/home/oval/ai/src/ROCmFPX-official/build-strix-rocmfp4/bin/llama-server \
#  -m /home/oval/ai/models/ROCMFPX/Qwen3.8-27B-Uncensored-Q4_0_ROCMFP4_STRIX.gguf \
#  --spec-type draft-mtp \
#  --model-draft /home/oval/ai/models/ROCMFPX/mtp-Qwen3.8-27B-Uncensored-Q4_0.gguf \
#  --spec-draft-n-max 3 \
#  --spec-draft-p-min 0.75 \
#  -ngl 999 -fa on -fit off \
#  -c 131072 \
#  -ctk q8_0 -ctv q8_0 \
#  --no-reasoning-preserve \
#  --jinja
ExecStart=/home/oval/ai/src/ROCmFPX-official/build-strix-rocmfp4/bin/llama-server \
  -m /home/oval/ai/models/ROCMFPX/Qwen3.8-27B-Uncensored-Q4_0_ROCMFP4_STRIX.gguf \
  --spec-type draft-mtp \
  --model-draft /home/oval/ai/models/ROCMFPX/mtp-Qwen3.8-27B-Uncensored-Q4_0.gguf \
  --spec-draft-n-max 4 \
  --spec-draft-p-min 0.75 \
  --spec-draft-ngl all \
  -ngl 999 -fa on \
  -c 131072 \
  -ctk q8_0 -ctv q4_0 \
  --kv-unified \
  --parallel 1 \
  --cache-reuse 256 \
  --cache-ram 8192 \
  -t 16 -tb 16 \
  --no-reasoning-preserve \
  --jinja
 
  
  
# 失败时自动重启
Restart=on-failure
RestartSec=10
# 日志输出到journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

