[Unit]
Description=Stable Diffusion.cpp sd-server (ROCm)
After=network.target

[Service]
Type=simple
User=oval
SupplementaryGroups=render
WorkingDirectory=/home/oval/ai/src/sd-official/stable-diffusion.cpp
Environment=LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib/llvm/lib:/home/oval/ai/src/sd-official/stable-diffusion.cpp/build-rocm/bin:/usr/lib/x86_64-linux-gnu
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=HSA_ENABLE_SDMA=0
Environment=ROCM_PATH=/opt/rocm
Environment=HIP_VISIBLE_DEVICES=0



ExecStart=/home/oval/ai/src/sd-official/stable-diffusion.cpp/build-rocm/bin/sd-server \
  --diffusion-model /home/oval/ai/models/QwenImage-2.1/qwen_image_2.1-Q4_K.gguf \
  --llm /home/oval/ai/models/QwenImage-2.1/Qwen3-VL-8B-Instruct-abliterated-v2.Q4_K_M.gguf \
  --vae /home/oval/ai/models/QwenImage-2.1/qwen_image_2.1_vae_bf16.safetensors \
  --backend diffusion=ROCm0,te=ROCm0,vae=ROCm0 \
  --sampling-method euler \
  --diffusion-fa \
  --flow-shift 3 \
  --steps 20 --cfg-scale 2.5 \
  --listen-ip 0.0.0.0 \
  --listen-port 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
